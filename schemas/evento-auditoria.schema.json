{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odin.exemplo.com.br/schemas/evento-auditoria.schema.json",
  "title": "Evento de auditoria (log estruturado → BigQuery odin_audit.eventos)",
  "description": "Arquitetura técnica, seção 4.4. Nunca contém o texto do pedido, token, cabeçalho Authorization ou segredo (RN-13).",
  "type": "object",
  "additionalProperties": false,
  "required": ["tipo", "ts", "servico", "ator", "acao", "resultado", "request_id"],
  "properties": {
    "tipo": { "const": "auditoria" },
    "ts": { "type": "string", "format": "date-time" },
    "servico": { "enum": ["odin-mcp", "odin-sts", "odin-portal", "odin-publisher", "odin-indexer", "odin-jobs", "odin-disjuntor", "odin-cli"] },
    "ator": { "type": "string", "pattern": "^(usr_[0-9a-z]+|sa:[a-z0-9-]+|sintetico|sistema)$" },
    "dispositivo": { "type": "string", "pattern": "^dev_[0-9a-z]+$" },
    "acao": { "type": "string", "pattern": "^[a-z]+(\\.[a-z_]+){1,3}$", "examples": ["mcp.rotear", "mcp.carregar_skill", "sts.token", "admin.grant.create"] },
    "alvo": { "type": "string", "maxLength": 200 },
    "resultado": { "enum": ["ok", "negado", "erro"] },
    "motivo": { "$ref": "#/$defs/codigoErro" },
    "ip": { "type": "string" },
    "ua": { "type": "string", "maxLength": 300 },
    "latencia_ms": { "type": "integer", "minimum": 0 },
    "skill": { "type": "string" },
    "versao": { "type": "string" },
    "request_id": { "type": "string", "minLength": 8, "maxLength": 64 },
    "antes": { "type": "object" },
    "depois": { "type": "object" }
  },
  "$defs": {
    "codigoErro": { "enum": ["sem_acesso", "skill_inexistente", "versao_indisponivel", "limite_excedido", "revogado", "manutencao", "invalido", "interno"] }
  }
}
