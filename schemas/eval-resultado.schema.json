{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odin.exemplo.com.br/schemas/eval-resultado.schema.json",
  "title": "evals/resultado.json: relatório de avaliação (odin.eval/1)",
  "description": "Gerado por `odin dev eval <skill>`; o CI do catálogo confere o SHA, a queda de nota e os casos críticos antes de promover para stable (ADR 0017).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "skill", "sha", "versao", "gerado_em", "repeticoes", "nota", "casos"],
  "properties": {
    "schema": { "const": "odin.eval/1" },
    "skill": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$" },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "versao": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
    "gerado_em": { "type": "string", "format": "date-time" },
    "repeticoes": { "type": "integer", "minimum": 1, "maximum": 9 },
    "nota": { "type": "number", "minimum": 0, "maximum": 100 },
    "nota_stable_anterior": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "casos": {
      "type": "array", "minItems": 10,
      "items": { "type": "object", "additionalProperties": false, "required": ["id", "critico", "resultado", "repeticoes"],
        "properties": {
          "id": { "type": "string", "pattern": "^EV-\\d{3}$" },
          "critico": { "type": "boolean" },
          "resultado": { "enum": ["passou", "falhou", "instavel"] },
          "repeticoes": { "type": "array", "minItems": 1, "items": { "enum": [0, 1] } },
          "motivo": { "type": "string" }
        } }
    }
  }
}
