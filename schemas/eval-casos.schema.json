{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odin.exemplo.com.br/schemas/eval-casos.schema.json",
  "title": "evals/casos.yaml: casos de avaliação de comportamento de uma skill",
  "description": "ADR 0017. Mínimo de 10 casos; a composição por tipo é conferida pelo odin lint.",
  "type": "array",
  "minItems": 10,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "titulo",
      "tipo",
      "camada",
      "fixture",
      "esperado"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^EV-\\d{3}$"
      },
      "titulo": {
        "type": "string",
        "minLength": 10,
        "maxLength": 160
      },
      "tipo": {
        "enum": [
          "positivo",
          "negativo",
          "injecao",
          "limite"
        ]
      },
      "critico": {
        "type": "boolean",
        "default": false
      },
      "camada": {
        "enum": [
          "deterministica",
          "modelo"
        ]
      },
      "fixture": {
        "type": "string",
        "pattern": "^fixtures/[a-z0-9-]+$"
      },
      "pedido": {
        "type": "string",
        "minLength": 8
      },
      "esperado": {
        "type": "array",
        "minItems": 0,
        "items": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 2,
          "additionalProperties": false,
          "properties": {
            "grader": {
              "type": "string",
              "pattern": "^graders/[a-z0-9-]+\\.mjs$"
            },
            "args": {
              "type": "object"
            },
            "arquivo_existe": {
              "type": "string"
            },
            "arquivo_ausente": {
              "type": "string"
            },
            "max_linhas": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "arquivo",
                "linhas"
              ],
              "properties": {
                "arquivo": {
                  "type": "string"
                },
                "linhas": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "dependentRequired": {
            "args": [
              "grader"
            ]
          }
        }
      },
      "juiz": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rubrica"
        ],
        "properties": {
          "rubrica": {
            "type": "string",
            "minLength": 20
          }
        }
      },
      "documento": {
        "type": "string",
        "minLength": 10,
        "maxLength": 6000,
        "description": "Camada modelo: conteúdo de um documento do projeto entregue junto com o pedido (por exemplo, texto com tentativa de injeção)."
      }
    },
    "if": {
      "properties": {
        "camada": {
          "const": "modelo"
        }
      }
    },
    "then": {
      "required": [
        "pedido",
        "juiz"
      ]
    },
    "else": {
      "required": [
        "esperado"
      ],
      "properties": {
        "esperado": {
          "type": "array",
          "minItems": 1
        }
      },
      "not": {
        "required": [
          "juiz"
        ]
      }
    }
  }
}