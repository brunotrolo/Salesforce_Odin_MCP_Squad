{
  "name": "odin-mcp-squad",
  "private": true,
  "type": "module",
  "description": "Odin MCP Squad: servidor MCP, emissor de tokens, CLI, guard, pipeline de publicação, contratos e documentação.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs tests/*.test.ts",
    "verificar": "node scripts/verificar-docs.mjs && node scripts/verificar-skills.mjs && node scripts/verificar-schemas.mjs && node scripts/verificar-libs.mjs && node scripts/conformidade.mjs && node scripts/avaliar-roteamento.ts && tsc -p .",
    "verificar:docs": "node scripts/verificar-docs.mjs",
    "verificar:skills": "node scripts/verificar-skills.mjs",
    "verificar:schemas": "node scripts/verificar-schemas.mjs",
    "conformidade": "node scripts/conformidade.mjs",
    "sessao:inicio": "node scripts/sessao.mjs inicio",
    "sessao:fim": "node scripts/sessao.mjs fim",
    "tipos": "tsc -p .",
    "avaliar:roteamento": "node scripts/avaliar-roteamento.ts --detalhe",
    "dev": "node dev/servidor.ts",
    "homologar": "node scripts/homologar.ts",
    "demo": "node dev/demo.ts",
    "odin": "node packages/cli/src/odin.ts",
    "prontidao": "node scripts/prontidao-skills.ts",
    "avaliar-skill": "node scripts/avaliar-skill.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@google-cloud/firestore": "9.4.1",
    "@google-cloud/kms": "6.3.0",
    "@google-cloud/storage": "9.0.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "google-auth-library": "11.3.4",
    "yaml": "2.9.1"
  }
}
